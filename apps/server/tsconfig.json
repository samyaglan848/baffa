{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "paths": {
      "@baffa/shared": ["../../packages/shared/src/index.ts", "../../packages/shared/dist/index.d.ts"],
      "@baffa/shared/*": ["../../packages/shared/src/*", "../../packages/shared/dist/*"],
      "@baffa/engine": ["../../packages/engine/src/index.ts", "../../packages/engine/dist/index.d.ts"],
      "@baffa/engine/*": ["../../packages/engine/src/*", "../../packages/engine/dist/*"]
    }
  },
  "include": ["src/**/*"]
}
