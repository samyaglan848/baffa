# ==========================================
# BAFFA (بَفّة) — Environment Configuration Template
# ==========================================

# Server Network & Port
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baffa_db?schema=public"

# JWT Security Secrets (Use 64+ char random keys in production)
JWT_SECRET="replace-with-a-very-long-secure-random-jwt-access-secret-string"
JWT_REFRESH_SECRET="replace-with-a-very-long-secure-random-jwt-refresh-secret-string"

# Email Provider Configuration (SMTP / SendGrid / AWS SES)
# Leave empty for Mock/Test Mode (development)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@baffa.eg"

# Official WhatsApp Cloud API (Meta Graph API)
# Leave empty if WhatsApp verification channel is not enabled
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Google OAuth 2.0 / Identity Services Configuration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
