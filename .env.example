# ===================================================
# BAFFA (بَفّة) — Production & Development Environment Configuration
# ===================================================

# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Authoritative Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baffa_db?schema=public"

# Authentication & Security Secrets
JWT_SECRET="baffa_production_jwt_secret_key_2026_super_secure"
JWT_REFRESH_SECRET="baffa_production_refresh_secret_key_2026_super_secure"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Web Client Configuration
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="BAFFA (بَفّة)"

# WebRTC Voice Configuration (STUN / TURN)
STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
